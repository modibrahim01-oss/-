# انسخ هذا الملف إلى .env.local وعبّئ القيم من لوحة Supabase
# Copy to .env.local and fill in from your Supabase dashboard

# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings → API → service_role. خادمي فقط: يُستخدم لإنشاء حسابات
# المشرفين من لوحة المدير. لا يُرسَل للمتصفح أبدًا.
SUPABASE_SERVICE_ROLE_KEY=
