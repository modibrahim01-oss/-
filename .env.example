# Supabase project settings — انسخ هذا الملف إلى .env.local وعبّئ القيم من لوحة Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Resend (بريد التنبيهات) — اختياري، اتركه فارغًا لتعطيل إرسال البريد
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=notifications@example.com
